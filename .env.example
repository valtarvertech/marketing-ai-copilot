# Marketing AI Copilot -- example environment file.
#
# The application runs fully without this file: all current
# functionality uses synthetic local CSV data and rule-based logic, no
# API keys required. These variables are placeholders for FUTURE
# integrations described in docs/ROADMAP.md. Copy this file to `.env`
# and fill in real values only when those integrations are built --
# never commit the real `.env` file (it's already in .gitignore).

# Future AI explanation layer (src/ai_layer.py) -- optional, not required to run the app.
ANTHROPIC_API_KEY=

# Future live ad platform connectors -- not implemented yet.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
META_ADS_ACCESS_TOKEN=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
